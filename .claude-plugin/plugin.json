{
  "name": "living-docs",
  "version": "0.35.0",
  "description": "Run a project's engineering decisions as a living log: ADRs, issues, research and architecture views kept current by the living-docs CLI.",
  "author": { "name": "Evaldo Klock" },
  "license": "MIT",
  "mcpServers": {
    "living-docs": {
      "command": "npx",
      "args": ["-y", "@ejklock/living-docs@0.35.0", "mcp", "--docs-dir", "${CLAUDE_PROJECT_DIR}/docs"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LIVING_DOCS_PLUGIN=1 \"${CLAUDE_PLUGIN_ROOT}/skills/living-docs/hooks/session-context.sh\""
          }
        ]
      }
    ]
  }
}
