{
  "minLines": 5,
  "ignorePattern": [
    "fn list\\(&self, root: &Path\\) -> io::Result<Vec<PathBuf>> \\{\\s*self\\.inner\\.list\\(root\\)\\s*\\}"
  ],
  "ignore": [
    "cli/tests/**",
    "scripts/tests/**",
    "**/tests.rs",
    "**/*_tests.rs",
    "**/tests/**",
    "living-docs-core/src/test_support.rs",
    "**/*.md"
  ]
}
